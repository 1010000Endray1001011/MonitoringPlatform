# Copy to .env and fill in real values. Never commit the real .env file.

# --- Django -----------------------------------------------------------
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------
# postgres://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgres://monitoringplatform:monitoringplatform@localhost:5432/monitoringplatform

# --- Redis: Celery broker, distributed locks, DRF throttling ------------
REDIS_URL=redis://localhost:6379/0

# --- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=alerts@monitoringplatform.local

# --- Telegram Bot API ------------------------------------------------
# One bot token for the whole platform — a NotificationChannel only stores
# which chat_id to send to, this same bot posts to all of them.
TELEGRAM_BOT_TOKEN=

# --- Celery -----------------------------------------------------------
# Set to True only for local debugging without a running worker; never in CI/prod.
CELERY_TASK_ALWAYS_EAGER=False

# --- Monitoring engine ---------------------------
# Must stay False outside of local/test — disables the SSRF guard.
MONITORING_ALLOW_PRIVATE_TARGETS=False
