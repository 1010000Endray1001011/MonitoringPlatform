# Copy to .env and fill in real values. Never commit the real .env file.

# --- Django -----------------------------------------------------------
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS: origins the frontend is served from ---------------------------
# local.py already hardcodes Vite's default dev port; this only matters for
# a non-default port or a production frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database -----------------------------------------------------------
# postgres://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgres://monitoringplatform:monitoringplatform@localhost:5432/monitoringplatform

# --- Redis: Celery broker, distributed locks, DRF throttling ------------
REDIS_URL=redis://localhost:6379/0

# --- Email ----------------------------------------------------------------
# The console backend prints notifications to the container's stdout and
# sends nothing — fine for development, useless for real alerts. Switch to
# the SMTP backend below to actually deliver mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Only read when EMAIL_BACKEND is the SMTP one — every other backend rejects
# these outright, so they are not passed along unless SMTP is selected.
# The values below are Gmail's; other providers differ only in host/port.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
# A Gmail App Password (16 characters, spaces optional), NOT the account
# password — Google requires 2FA to be on before it will issue one.
EMAIL_HOST_PASSWORD=
# STARTTLS on 587. For implicit TLS on port 465 set EMAIL_USE_SSL=True
# instead; the two are mutually exclusive and setting both fails at startup.
EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# Seconds. Keeps a hung SMTP server from pinning the Celery worker that is
# trying to send an alert.
EMAIL_TIMEOUT=10

# Must match EMAIL_HOST_USER on Gmail and most other providers — a From
# address the provider hasn't authenticated gets rewritten or rejected.
DEFAULT_FROM_EMAIL=alerts@monitoringplatform.local

# --- Telegram Bot API ------------------------------------------------
# One bot token for the whole platform — a NotificationChannel only stores
# which chat_id to send to, this same bot posts to all of them.
TELEGRAM_BOT_TOKEN=
# The bot's @name, e.g. my_monitoring_bot — a leading @ is accepted and
# stripped. Used to build the t.me link a user taps to connect their chat,
# so it must match the token above.
TELEGRAM_BOT_USERNAME=
# How long a connect link stays usable. Long enough to walk to your phone,
# short enough that a link left open in a browser tab stops working.
TELEGRAM_CLAIM_TTL_MINUTES=30

# --- Celery -----------------------------------------------------------
# Set to True only for local debugging without a running worker; never in CI/prod.
CELERY_TASK_ALWAYS_EAGER=False

# --- Monitoring engine ---------------------------
# Must stay False outside of local/test — disables the SSRF guard.
MONITORING_ALLOW_PRIVATE_TARGETS=False
