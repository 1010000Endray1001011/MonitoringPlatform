# Build context for frontend/Dockerfile. `npm ci` reinstalls dependencies
# inside the image from package-lock.json, so copying a host node_modules in
# would be both enormous and wrong — native modules built against the host
# platform, not the image's.
node_modules/
dist/

# Vite inlines import.meta.env.* at build time from the VITE_API_BASE_URL
# build arg compose passes, never from a .env file inside the image.
.env
.env.*
!.env.example

# Vite's own convention for machine-local overrides (.env.local,
# *.local) — never part of a reproducible image build.
*.local

.DS_Store
